      "seed": 1378962000,
      "version": 668,
      "versionNonce": 892398160,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793469554407,
      "created": 1793469299601,
      "link": null,
      "locked": false,
      "text": "Distributed System ek bhot badi problem ko solve\nkar rha hai hamari application millions of users tak\nscale ho sakti but bhot sari problems k sath jaise\n\n1.do servers k beech interaction kaise hoga\n2.kal ko yeah scale up kaise honge\n3.apne aap sclae down kaise honge\n4.agr s2 k paas koe data hai to wo s1,s3,s4,s5 inn sab k sath share kaise karega",
      "fontSize": 28,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Distributed System ek bhot badi problem ko solve\nkar rha hai hamari application millions of users tak\nscale ho sakti but bhot sari problems k sath jaise\n\n1.do servers k beech interaction kaise hoga\n2.kal ko yeah scale up kaise honge\n3.apne aap sclae down kaise honge\n4.agr s2 k paas koe data hai to wo s1,s3,s4,s5 inn sab k sath share kaise karega",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
