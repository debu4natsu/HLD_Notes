    {
      "id": "NsARdqFfORUS5dUQezmGp",
      "type": "text",
      "x": 3707.3424221095875,
      "y": 11445.70362363828,
      "width": 800,
      "height": 405,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b9e",
      "roundness": null,
      "seed": 440005780,
      "version": 392,
      "versionNonce": 1619343527,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793858969524,
      "created": 1793640180834,
      "link": null,
      "locked": false,
      "text": "Client LB se phele CDN k paas\njta hai, aur puchta hai kya uske pass wo\nstatic content hai kya\n\nAgr nhi hota to to wo dusre CND k pass jta\nagr mila to client ko sari cheeze dhik jati hai'\n\nAgr nhi to ultimately servers ko request bhej\ndiya jta hai",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Client LB se phele CDN k paas\njta hai, aur puchta hai kya uske pass wo static content hai kya\n\nAgr nhi hota to to wo dusre CND k pass jta\nagr mila to client ko sari cheeze dhik jati hai'\n\nAgr nhi to ultimately servers ko request bhej diya jta hai",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "356dWSakYPXY-BUzh00kB",
      "type": "text",
      "x": 4819.773503193597,
      "y": 11421.875471587258,
      "width": 800,
      "height": 450,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b9f",
      "roundness": null,
      "seed": 791796396,
      "version": 407,
      "versionNonce": 616926151,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793858969524,
      "created": 1793640315453,
      "link": null,
      "locked": false,
      "text": "CDN me static content, images yhi sab hoti\nhai\n\nExample Myntra, Flipkart unhe products k\nimage dhikhane hai to baar baar server ko\nrequest mrne ka koe tuk nhi banta\nBetter hai CND se maal utha lo\n\nrhi baat product purchae, add to cart ki wo\nsab server handel krta hai",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "CDN me static content, images yhi sab hoti hai\n\nExample Myntra, Flipkart unhe products k image dhikhane hai to baar baar server ko request mrne ka koe tuk nhi banta\nBetter hai CND se maal utha lo\n\nrhi baat product purchae, add to cart ki wo sab server handel krta hai",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
